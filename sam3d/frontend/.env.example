# 상시 켜져 있는 백엔드(대화형 작업: SAM2 마스크, LaMa 제거, 가구 추출).
# 1초 안에 끝나고 한 세션에서 수십 번 호출되므로 큐에 넣지 않는다.
VITE_API_URL=http://127.0.0.1:8001

# 작업 접수 서버(GPU 배치 작업: SAM3D 메쉬, uLayout 방 치수, Omni3D 크기).
# 큐를 켰을 때만 쓰인다.
VITE_JOB_API_URL=http://127.0.0.1:8000

# 1이면 GPU 작업이 큐를 탄다(접수 → 폴링 → S3에서 결과 수령).
# 비워두면 기존처럼 VITE_API_URL로 동기 호출한다.
# 로컬에서 실제 모델을 돌릴 때는 비워두고, 배포 환경에서만 1로 둔다.
VITE_USE_JOB_QUEUE=
